# Port the local dev server listens on (integer 1-65535)
PORT=3000

# Neon pooled connection string: only in the local .env or the Netlify UI, never in git or in chat
DATABASE_URL=

# Resend API key (https://resend.com/api-keys): only in the local .env or the Netlify UI, never in git or in chat.
# Without it the app works and POST /api/claims/:id/email answers 503 EMAIL_NOT_CONFIGURED
RESEND_API_KEY=

# Sender of the emails. Default: Reclama <onboarding@resend.dev> (Resend's shared test sender, no domain needed)
EMAIL_FROM=

# sandbox (default) or live. In sandbox every email goes to EMAIL_TEST_RECIPIENT and never to the debtor
# (without a verified sending domain Resend only delivers to the account owner). live sends to the debtor
# and needs a verified domain in EMAIL_FROM. Demo accounts always use sandbox
EMAIL_MODE=

# Where sandbox emails go. Default: delivered@resend.dev (Resend's test inbox that accepts everything)
EMAIL_TEST_RECIPIENT=
